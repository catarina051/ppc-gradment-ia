# Copie para .env e preencha suas chaves gratuitas. O .env está no .gitignore e NUNCA vai para o Git.
# Custo zero garantido: todos os modelos padrão abaixo operam em cotas gratuitas (sem cartão de crédito).

# ==============================================================================
# CHAVES DE API GRATUITAS POR PROVEDOR
# ==============================================================================
# 1. Google Gemini API (Free Tier): https://aistudio.google.com/api-keys
GEMINI_API_KEY=

# 2. OpenRouter (Modelos ":free" a $0.00): https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# 3. GroqCloud (Free Tier): https://console.groq.com/keys
GROQ_API_KEY=

# 4. Mistral AI — La Plateforme (Plano Experiment gratuito, opcional): https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# Provedores opcionais adicionais (deixe vazios para operar 100% gratuito)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ==============================================================================
# CONFIGURAÇÃO DAS 3 IAs DO FLUXO (3 Provedores Gratuitos Distintos)
# Provedores aceitos: gemini | openrouter | groq | mistral | openai | anthropic
# ==============================================================================
# IA 1: Extratora Primária Top-Down (1M contexto, ~250k TPM gratuitos, JSON Schema nativo)
IA1_PROVIDER=gemini
IA1_MODEL=gemini-3.5-flash-lite
IA1_API_KEY=
IA1_BASE_URL=

# IA 2: Auditora Independente Bottom-Up (1M contexto, 131k saída, $0.00 garantido pelo sufixo :free)
IA2_PROVIDER=openrouter
IA2_MODEL=nvidia/nemotron-3.5-super-vl:free
IA2_API_KEY=
IA2_BASE_URL=

# IA 3: Juíza de Desempate sob demanda (acionada APENAS quando há divergência entre IA 1 e IA 2)
# Alternativa gratuita p/ documentos gigantes sem corte: IA3_PROVIDER=mistral e IA3_MODEL=mistral-small-latest
IA3_PROVIDER=groq
IA3_MODEL=openai/gpt-oss-120b
IA3_API_KEY=
IA3_BASE_URL=

# ==============================================================================
# INFRAESTRUTURA N8N / DOCKER
# ==============================================================================
# Gere com: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
N8N_ENCRYPTION_KEY=

N8N_PORTA=5680
WEBHOOK_URL=http://localhost:5680/
GENERIC_TIMEZONE=America/Sao_Paulo
